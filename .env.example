# =====================================================
# LOCAL CODERABBIT - ENVIRONMENT TEMPLATE
# =====================================================
# Copy to .env and fill in your values
# DO NOT COMMIT .env TO VERSION CONTROL

# =====================================================
# GitHub Configuration
# =====================================================
# Create a Fine-Grained PAT at:
# GitHub > Settings > Developer settings > Personal access tokens > Fine-grained
# Permissions: Contents (Read), Pull requests (Read & Write)
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE
GITHUB_WEBHOOK_SECRET=your_webhook_secret_min_32_chars

# =====================================================
# Z.AI Configuration (Reviewer Agent - GLM-4)
# =====================================================
# Get your API key from your Z.AI dashboard
# OpenAI-compatible endpoint for PR-Agent
ZAI_API_BASE=https://api.z.ai/v1
ZAI_API_KEY=z-ai-xxxx-your-key-here
ZAI_MODEL=glm-4

# Alternative models: glm-4-flash (faster), glm-4-plus (more capable)

# =====================================================
# Gemini Configuration (Utility Agent)
# =====================================================
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy-your-gemini-key

# =====================================================
# PR-Agent Configuration
# =====================================================
PR_AGENT_PORT=3000
PR_AGENT_AUTO_REVIEW=true
PR_AGENT_AUTO_DESCRIBE=true
PR_AGENT_AUTO_IMPROVE=true
PR_AGENT_LOG_LEVEL=info

# =====================================================
# Infrastructure
# =====================================================
DOCKER_COMPOSE_PROJECT_NAME=local-coderabbit
ENVIRONMENT=development

# Webhook URL (update when using ngrok or VPS)
WEBHOOK_URL=http://localhost:3000
# WEBHOOK_URL=https://your-ngrok-url.ngrok.io  # For ngrok
# WEBHOOK_URL=https://your-domain.com          # For VPS

# =====================================================
# Team Notifications (Optional)
# =====================================================
# Slack: Create an Incoming Webhook at
# https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Discord: Server Settings > Integrations > Webhooks > Create Webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXX/YYY
