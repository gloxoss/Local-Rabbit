{
    "model": "glm-4.7-flash",
    "min_severity": "warning",
    "severity_levels": {
        "critical": 3,
        "warning": 2,
        "suggestion": 1
    },
    "notifications": {
        "enabled": true,
        "on_critical_only": true
    },
    "history": {
        "enabled": true,
        "folder": "reviews"
    },
    "webhooks": {
        "enabled": false,
        "slack_url": "",
        "discord_url": "",
        "notify_on": [
            "critical",
            "warning"
        ],
        "include_code_snippet": true,
        "daily_digest": false
    },
    "debounce_seconds": 3,
    "watch_extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".py",
        ".go",
        ".rs",
        ".vue",
        ".svelte"
    ],
    "ignore_dirs": [
        "node_modules",
        ".git",
        "__pycache__",
        "dist",
        "build",
        ".next",
        ".agent",
        "reviews"
    ],
    "cortex": {
        "enabled": true,
        "db_path": "data/cortex_db",
        "collection_name": "cortex_codebase_v2",
        "model": "nomic-embed-text"
    },
    "orchestrator": {
        "mode": "combined",
        "log_file": "data/orchestrator.log",
        "projects": [
            "."
        ]
    },
    "schedule": {
        "daily_audit": "18:00",
        "enabled": true
    },
    "email": {
        "enabled": false,
        "smtp_host": "",
        "smtp_port": 587,
        "smtp_user": "",
        "smtp_password_env": "SMTP_PASSWORD",
        "from": "",
        "to": [],
        "on_critical": true,
        "daily_digest": true
    }
}